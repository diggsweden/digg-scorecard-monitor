#!/usr/bin/env bash
# Generates the shared public repository list used by monitor reports.

set -euo pipefail

ORG="diggsweden"
OUTPUT="reporting/repositories.json"
SOURCE_REPOSITORY="diggsweden/digg-scorecard-monitor"
WORKFLOW_NAME="scorecard-monitor.yml"
GENERATED_AT="${GENERATED_AT:-}"

usage() {
  cat <<'EOF'
Usage: list_public_repositories [options]

Options:
  --org ORG                 GitHub organisation. Default: diggsweden
  --output PATH             Output JSON report. Default: reporting/repositories.json
  --source-repository REPO  Source repository. Default: diggsweden/digg-scorecard-monitor
  --workflow NAME           Workflow filename. Default: scorecard-monitor.yml
  --generated-at TIMESTAMP  Override generation timestamp.
EOF
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [ -z "$value" ]; then
    echo "Missing value for $option" >&2
    usage >&2
    exit 1
  fi
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "$command_name is required." >&2
    exit 1
  fi
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --org)
        require_value "$1" "${2:-}"
        ORG="${2:-}"
        shift 2
        ;;
      --output)
        require_value "$1" "${2:-}"
        OUTPUT="${2:-}"
        shift 2
        ;;
      --source-repository)
        require_value "$1" "${2:-}"
        SOURCE_REPOSITORY="${2:-}"
        shift 2
        ;;
      --workflow)
        require_value "$1" "${2:-}"
        WORKFLOW_NAME="${2:-}"
        shift 2
        ;;
      --generated-at)
        require_value "$1" "${2:-}"
        GENERATED_AT="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

auth_header_args() {
  local token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"

  if [ -n "$token" ]; then
    printf '%s\n' -H "Authorization: Bearer $token"
  fi
}

fetch_url() {
  local url="$1"
  local output="$2"
  local status
  local auth_args=()

  mapfile -t auth_args < <(auth_header_args)
  status="$(curl -sSL \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${auth_args[@]}" \
    -o "$output" \
    -w '%{http_code}' \
    "$url")" || status="000"

  printf '%s\n' "$status"
}

fetch_page() {
  local page="$1"
  local output="$2"
  local status

  status="$(fetch_url "https://api.github.com/orgs/$ORG/repos?per_page=100&type=public&page=$page" "$output")"
  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    echo "Request failed ($status): GitHub public repository list for $ORG page $page" >&2
    return 1
  fi
}

fetch_repositories() {
  local count
  local page=1
  local page_file

  repositories_file="$(mktemp)"
  tmp_files+=("$repositories_file")
  : > "$repositories_file"

  while :; do
    page_file="$(mktemp)"
    tmp_files+=("$page_file")
    fetch_page "$page" "$page_file"
    count="$(jq 'length' "$page_file")"
    [ "$count" -eq 0 ] && break

    jq -c '.[]' "$page_file" >> "$repositories_file"
    page=$((page + 1))
  done
}

write_report() {
  local tmp_output

  mkdir -p "$(dirname "$OUTPUT")"
  tmp_output="$(mktemp)"
  tmp_files+=("$tmp_output")

  jq -s \
    --arg generated_at "$GENERATED_AT" \
    --arg source_repository "$SOURCE_REPOSITORY" \
    --arg workflow_name "$WORKFLOW_NAME" \
    --arg workflow_run_id "${GITHUB_RUN_ID:-}" \
    --arg org "$ORG" '
      def license_spdx: .license.spdx_id // null | if . == "NOASSERTION" then null else . end;

      map(select(.private == false and .visibility == "public"))
      | map({
          name: .full_name,
          platform: "github.com",
          org: $org,
          repo: .name,
          url: .html_url,
          default_branch: (.default_branch // null),
          pushed_at: (.pushed_at // null),
          fork: (.fork // null),
          archived: (.archived // null),
          private: (.private // null),
          visibility: (.visibility // null),
          github_license: license_spdx
        })
      | sort_by(.name | ascii_downcase) as $repos
      | {
          schema_version: 1,
          generated_at: $generated_at,
          source: {
            repository: $source_repository,
            workflow: $workflow_name,
            workflow_run_id: (if $workflow_run_id == "" then null else $workflow_run_id end),
            org: $org,
            api_path: ("/orgs/" + $org + "/repos?type=public")
          },
          summary: {
            total_repositories: ($repos | length),
            active_repositories: ($repos | map(select(.archived == false)) | length),
            archived_repositories: ($repos | map(select(.archived == true)) | length),
            fork_repositories: ($repos | map(select(.fork == true)) | length)
          },
          repositories: $repos
        }
    ' "$repositories_file" > "$tmp_output"

  jq -e '
    .schema_version == 1 and
    (.source.org | type == "string") and
    (.repositories | type == "array") and
    (.summary.total_repositories == (.repositories | length))
  ' "$tmp_output" >/dev/null

  mv "$tmp_output" "$OUTPUT"
  echo "Wrote public repository list to $OUTPUT"
}

main() {
  parse_args "$@"
  require_command curl
  require_command jq

  if [ -z "$GENERATED_AT" ]; then
    GENERATED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  fi

  tmp_files=()
  trap 'rm -f "${tmp_files[@]}"' EXIT

  fetch_repositories
  write_report

  trap - EXIT
  rm -f "${tmp_files[@]}"
}

main "$@"
