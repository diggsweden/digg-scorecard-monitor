#!/usr/bin/env bash
# Appends rows to the scorecard report for diggsweden repos that don't
# implement reusable-ci's security-openssf-scorecard.yml workflow.

set -euo pipefail

ORG="diggsweden"
REPORT="reporting/openssf-scorecard-report.md"
SCOPE="reporting/scope.json"
REPOSITORIES="reporting/repositories.json"
REPORT_EXCLUSIONS="reporting/report-exclusions.json"
REPORT_KEY="openssf_scorecard"
WORKFLOW_STATUS_OUTPUT=""
APPROVED_WORKFLOW_PREFIX="diggsweden/reusable-ci/.github/workflows/security-openssf-scorecard.yml@"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=scripts/lib/scorecard_workflows.sh
source "$SCRIPT_DIR/lib/scorecard_workflows.sh"
# shellcheck source=scripts/lib/report_exclusions.sh
source "$SCRIPT_DIR/lib/report_exclusions.sh"

usage() {
  cat <<'EOF'
Usage: append_repos_without_scorecard [--repositories PATH] [--report-exclusions PATH] [--workflow-status PATH]

Appends Markdown rows for active, non-excluded repositories that do not use
Digg's approved OpenSSF Scorecard workflow. Optionally writes workflow status
data as JSON for the structured report.

Options:
  --repositories PATH        Shared public repository list. Default: reporting/repositories.json
  --report-exclusions PATH   Report-specific exclusions. Default: reporting/report-exclusions.json
  --workflow-status PATH     Output workflow status JSON.
EOF
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [ -z "$value" ]; then
    echo "Missing value for $option" >&2
    usage >&2
    exit 1
  fi
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repositories)
        require_value "$1" "${2:-}"
        REPOSITORIES="${2:-}"
        shift 2
        ;;
      --report-exclusions)
        require_value "$1" "${2:-}"
        REPORT_EXCLUSIONS="${2:-}"
        shift 2
        ;;
      --workflow-status)
        require_value "$1" "${2:-}"
        WORKFLOW_STATUS_OUTPUT="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "$command_name is required." >&2
    exit 1
  fi
}

load_excluded_repos() {
  excluded_repos=()

  if [ -f "$SCOPE" ]; then
    mapfile -t excluded_repos < <(jq -r --arg org "$ORG" '."github.com"[$org].excluded[]?' "$SCOPE")
  fi
}

is_excluded() {
  local needle="$1"
  local repo

  for repo in "${excluded_repos[@]}"; do
    [ "$repo" = "$needle" ] && return 0
  done

  return 1
}

report_contains_repo() {
  local needle="[$ORG/$1]("
  local line

  while IFS= read -r line; do
    [[ "$line" == *"$needle"* ]] && return 0
  done < "$REPORT"

  return 1
}

load_repository_names() {
  repository_names=()

  [ -f "$REPOSITORIES" ] || {
    echo "Repository list not found: $REPOSITORIES" >&2
    exit 1
  }

  jq -e '
    .schema_version == 1 and
    (.repositories | type == "array")
  ' "$REPOSITORIES" >/dev/null || {
    echo "Invalid repository list: $REPOSITORIES" >&2
    exit 1
  }

  mapfile -t repository_names < <(jq -r --arg org "$ORG" '
    .repositories[]
    | select(.org == $org and (.archived // false) == false and (.private // false) == false)
    | .repo
  ' "$REPOSITORIES")
}

add_workflow_status_row() {
  local repo="$1"
  local status="$2"

  workflow_status_rows+=("$(jq -c -n \
    --arg org "$ORG" \
    --arg repo "$repo" \
    --arg status "$status" \
    '{
      org: $org,
      repo: $repo,
      name: ($org + "/" + $repo),
      url: ("https://github.com/" + $org + "/" + $repo),
      workflow_status: $status
    }')")
}

workflow_status_for_repo() {
  local repo="$1"
  local api_error
  local api_error_file
  local file
  local files
  local found=0
  local inspect_error=0
  local workflow_check_result

  api_error_file="$(mktemp)"
  if ! files=$(gh api "repos/$ORG/$repo/contents/.github/workflows" \
    --jq '.[].download_url' 2>"$api_error_file"); then
    api_error="$(<"$api_error_file")"
    rm -f "$api_error_file"

    case "$api_error" in
      *"HTTP 404"*|*"Not Found"*)
        printf 'missing_approved_workflow\n'
        ;;
      *)
        echo "Could not inspect workflows for $repo; marking workflow status unknown." >&2
        printf 'unknown\n'
        ;;
    esac
    return 0
  fi
  rm -f "$api_error_file"

  if [ -z "$files" ]; then
    printf 'missing_approved_workflow\n'
    return 0
  fi

  for file in $files; do
    if scorecard_workflow_uses_approved_ref "$file" "$APPROVED_WORKFLOW_PREFIX"; then
      found=1
      break
    else
      workflow_check_result="$?"
      [ "$workflow_check_result" -eq 2 ] && inspect_error=1
    fi
  done

  if [ "$found" -eq 1 ]; then
    printf 'approved\n'
  elif [ "$inspect_error" -eq 1 ]; then
    echo "Could not inspect one or more workflow files for $repo; marking workflow status unknown." >&2
    printf 'unknown\n'
  else
    printf 'missing_approved_workflow\n'
  fi
}

scan_repositories() {
  local repo
  local workflow_status

  echo "Scanning $ORG repos for missing security-openssf-scorecard.yml..."

  for repo in "${repository_names[@]}"; do
    if is_excluded "$repo"; then
      echo "Skipping excluded: $repo"
      continue
    fi

    if is_report_excluded "$repo"; then
      echo "Skipping report-specific excluded: $repo"
      continue
    fi

    echo "Checking $repo..."
    workflow_status="$(workflow_status_for_repo "$repo")"

    if [ "$workflow_status" = "missing_approved_workflow" ]; then
      no_scorecard+=("$repo")
    fi

    add_workflow_status_row "$repo" "$workflow_status"
  done
}

write_workflow_status() {
  [ -n "$WORKFLOW_STATUS_OUTPUT" ] || return 0

  mkdir -p "$(dirname "$WORKFLOW_STATUS_OUTPUT")"
  if [ "${#workflow_status_rows[@]}" -eq 0 ]; then
    printf '[]\n' > "$WORKFLOW_STATUS_OUTPUT"
  else
    printf '%s\n' "${workflow_status_rows[@]}" | jq -s 'sort_by(.name | ascii_downcase)' > "$WORKFLOW_STATUS_OUTPUT"
  fi
  echo "Wrote workflow status to $WORKFLOW_STATUS_OUTPUT"
}

build_new_rows() {
  local repo
  local url

  new_rows=()
  for repo in "${no_scorecard[@]}"; do
    if report_contains_repo "$repo"; then
      echo "  Skipping $repo (already in report)"
      continue
    fi

    url="https://github.com/$ORG/$repo"
    new_rows+=("| [$ORG/$repo]($url) | - | - | - | - | - |")
    echo "  Adding $repo"
  done
}

append_new_rows() {
  local i
  local last_table_idx=-1
  local tmp_report
  local report_lines=()

  if [ "${#no_scorecard[@]}" -eq 0 ]; then
    echo "All repos implement security-openssf-scorecard.yml — nothing to append."
    return 0
  fi

  build_new_rows
  if [ "${#new_rows[@]}" -eq 0 ]; then
    echo "No new repos to add."
    return 0
  fi

  echo "Appending ${#new_rows[@]} repo(s) to report..."

  mapfile -t report_lines < "$REPORT"
  for i in "${!report_lines[@]}"; do
    [[ "${report_lines[$i]}" == *"|" ]] && last_table_idx="$i"
  done

  if [ "$last_table_idx" -lt 0 ]; then
    echo "Could not find table rows in $REPORT" >&2
    exit 1
  fi

  tmp_report="$(mktemp)"
  for i in "${!report_lines[@]}"; do
    printf '%s\n' "${report_lines[$i]}" >> "$tmp_report"
    if [ "$i" -eq "$last_table_idx" ]; then
      printf '%s\n' "${new_rows[@]}" >> "$tmp_report"
    fi
  done

  mv "$tmp_report" "$REPORT"
  echo "Done."
}

main() {
  parse_args "$@"

  if [ ! -f "$REPORT" ]; then
    echo "Report not found: $REPORT"
    echo "Skipping script — report will be generated by GitHub Action first."
    exit 0
  fi

  require_command jq
  require_command gh
  load_excluded_repos
  load_report_exclusions "$REPORT_EXCLUSIONS" "$REPORT_KEY"
  load_repository_names
  validate_report_exclusions_repositories "$REPOSITORIES" "$ORG"

  no_scorecard=()
  workflow_status_rows=()
  new_rows=()

  scan_repositories
  write_workflow_status
  append_new_rows
}

main "$@"
